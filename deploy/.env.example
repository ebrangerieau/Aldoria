# Copier en /docker/aldoria/.env sur le VPS (jamais dans le dépôt).
COMPOSE_PROJECT_NAME=aldoria
TRAEFIK_HOST=bandtrack.fr

# Tag des images GHCR à déployer (la CI déploie le SHA du commit).
ALDORIA_TAG=latest

POSTGRES_USER=aldoria
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=aldoria

# Secret de signature des jetons joueurs (≥ 32 octets) : openssl rand -hex 32
ALDORIA_JWT_SECRET=change-moi
