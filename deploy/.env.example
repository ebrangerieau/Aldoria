# Copier en /docker/aldoria/.env sur le VPS (jamais dans le dépôt).
COMPOSE_PROJECT_NAME=aldoria
TRAEFIK_HOST=bandtrack.fr

# Tag des images GHCR à déployer (la CI déploie le SHA du commit).
ALDORIA_TAG=latest

POSTGRES_USER=aldoria
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=aldoria

# Secret de signature des jetons joueurs (≥ 32 octets) : openssl rand -hex 32
ALDORIA_JWT_SECRET=change-moi

# Espace parent (aldoria-admin) : secret ajouté par Traefik aux appels de l'API parent
# (≥ 32 caractères) : openssl rand -hex 32
ALDORIA_ADMIN_KEY=change-moi
# Les adultes se connectent avec leur compte Aldoria : premier compte créé par
#   docker compose exec -T api python -m app.cli invite --family 1 --operator

# Questions proposées par l'IA (espace parent → Questions → Proposer avec l'IA), facultatif :
# clé d'API Anthropic (console.anthropic.com) et nombre de demandes par famille et par jour.
ALDORIA_ANTHROPIC_API_KEY=
ALDORIA_AI_DAILY_LIMIT=20

# Sauvegarde quotidienne de la base (service backup) : heure UTC de départ et nombre de
# sauvegardes gardées sur le VPS (les plus récentes). Facultatif.
SAUVEGARDE_HEURE=3
SAUVEGARDE_NOMBRE=14
